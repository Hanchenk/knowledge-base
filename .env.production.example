# Run: docker compose --env-file .env.production up --build -d
# Point DOMAIN's DNS to this server; ports 80/443 must be available for certificates.
DOMAIN=knowledge.example.com
# Use distinct random values, e.g. openssl rand -hex 24. Avoid URL special characters in POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replaceWithRandomPostgresPassword
MINIO_ROOT_USER=atlas-root
MINIO_ROOT_PASSWORD=replaceWithRandomMinioRootPassword
S3_ACCESS_KEY=atlas-service
S3_SECRET_KEY=replaceWithRandomS3ServicePassword
BOOTSTRAP_TENANT_SLUG=company
BOOTSTRAP_TENANT_NAME=My Company
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replaceWithRandomAdminPassword
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
PI_AGENT_ENABLED=true
AGENT_WEB_ENABLED=true
WEB_SEARCH_URL=
# Generate once with: openssl rand -base64 32. Keep stable and back up separately.
MODEL_CONFIG_ENCRYPTION_KEY=
CHAT_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
VISION_BASE_URL=
VISION_API_KEY=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
