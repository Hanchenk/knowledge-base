{
  "name": "atlas-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "agent:example": "node examples/mcp-agent.mjs",
    "format": "prettier --write src examples e2e *.ts",
    "format:check": "prettier --check src examples e2e *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
