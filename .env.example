ENVIRONMENT=development
DATABASE_URL=sqlite://data/atlas.db?mode=rwc
STORAGE_PATH=data/files
# Set when using PostgreSQL + Qdrant (Compose sets this automatically).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=atlas
# Explicit LAN HTTP opt-in; use false with HTTPS.
ALLOW_INSECURE_HTTP=false
BIND_ADDRESS=127.0.0.1:8000
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=true
WORKER_ENABLED=true
PI_AGENT_ENABLED=true
BOT_CODE_ENABLED=false
BOT_CODE_IMAGE=python:3.12-alpine
# Exact allowed authorities, for example api.github.com:443,graph.microsoft.com:443
BOT_CONNECTOR_HOSTS=
PI_AGENT_NODE=node
PI_AGENT_SCRIPT=agent-runtime/agent.mjs
# Set this to the actual context capacity of the configured chat model.
AGENT_CONTEXT_WINDOW=32768
AGENT_MAX_OUTPUT_TOKENS=5000
# Productive bot tasks yield at completed turns, then automatically resume.
BOT_AGENT_SLICE_SECONDS=600
AGENT_WEB_ENABLED=true
# Optional SearXNG JSON search endpoint; blank uses public Bing RSS.
WEB_SEARCH_URL=
PROCESSOR_PYTHON=processor/.venv/bin/python
PROCESSOR_SCRIPT=processor/extract.py
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Optional in development (auto-generated local key otherwise). Production: openssl rand -base64 32
MODEL_CONFIG_ENCRYPTION_KEY=
CHAT_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
VISION_BASE_URL=
VISION_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# SSO: existing active users only; match verified email.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_SLUG=atlas
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Production requires PostgreSQL, S3 and HTTPS. Demo users are prohibited.
