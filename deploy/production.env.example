# Copy to .env on the deployment host; generate independent strong secrets.
PUBLIC_URL=http://192.168.1.34:18088
HTTP_PORT=18088
ALLOW_INSECURE_HTTP=true
POSTGRES_PASSWORD=
MINIO_ROOT_USER=atlas-root
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=atlas-service
S3_SECRET_KEY=
QDRANT_API_KEY=
MODEL_CONFIG_ENCRYPTION_KEY=
BOOTSTRAP_TENANT_SLUG=Yemast
BOOTSTRAP_TENANT_NAME=Yemast
BOOTSTRAP_ADMIN_EMAIL=admin@yemast.com
BOOTSTRAP_ADMIN_PASSWORD=
# HTTPS: set PUBLIC_URL=https://your-domain, DOMAIN=your-domain,
# ALLOW_INSECURE_HTTP=false, use deploy/compose.https.yaml override.
