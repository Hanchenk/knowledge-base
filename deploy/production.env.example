# Copy to .env on the deployment host; generate independent strong secrets.
PUBLIC_URL=http://192.168.1.34:18088
HTTP_PORT=18088
ALLOW_INSECURE_HTTP=true
POSTGRES_PASSWORD=
MINIO_ROOT_USER=atlas-root
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=atlas-service
S3_SECRET_KEY=
QDRANT_API_KEY=
MODEL_CONFIG_ENCRYPTION_KEY=
BOOTSTRAP_TENANT_SLUG=Yemast
BOOTSTRAP_TENANT_NAME=Yemast
BOOTSTRAP_ADMIN_EMAIL=admin@yemast.com
BOOTSTRAP_ADMIN_PASSWORD=
# DeepSeek Harness requires compose.bot-code.yaml's isolated Docker daemon.
# The override shares /app/data/harness and sets each service's bridge host.
BOT_HARNESS_ENABLED=true
BOT_HARNESS_IMAGE=node:22-bookworm-slim
# Set false to disable platform public-web tools globally.
AGENT_WEB_ENABLED=true
# HTTPS: set PUBLIC_URL=https://your-domain, DOMAIN=your-domain,
# ALLOW_INSECURE_HTTP=false, use deploy/compose.https.yaml override.

# Personal memory and reviewed skills (optional TencentDB MemoryCore)
# Leave endpoints blank to use local approved personal memory and manual/model skill drafts.
MEMORY_CORE_URL=
MEMORY_CORE_TOKEN=
# Server-only native registry admin key; required for upstream skill extraction.
MEMORY_CORE_ADMIN_USER_KEY=
# Wiki / CodeGraph require a private MemoryKnowledge service behind authenticated gateway.
MEMORY_KNOWLEDGE_URL=
MEMORY_KNOWLEDGE_TOKEN=
MEMORY_SERVICE_ID=zhixiaohui
# See docs/wiki-codegraph-integration.md for optional provider containers and model settings.
